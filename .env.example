# Envío por correo del consentimiento firmado (ver
# graphic_interface/consent/consent_mailer.py).
# Copia este archivo a ".env" y complétalo; ".env" no se sube al repo.
#
# Gmail: SMTP_PASSWORD debe ser una "contraseña de aplicación" (requiere
# verificación en dos pasos): https://myaccount.google.com/apppasswords
# Puerto 587 = STARTTLS, 465 = SSL.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
RESEARCHER_EMAIL=

# Juez de prompts (LLM-as-a-judge, ver graphic_interface/judge/). Clave de la
# API de Anthropic: https://console.anthropic.com/ -- solo la usa el
# investigador al evaluar prompts, nunca la sesión de los participantes.
ANTHROPIC_API_KEY=
# Para evaluar con la suscripción de Claude (CLI `claude`, sin clave de API ni
# costo adicional, pero sin poder fijar la temperatura en 0):
# JUDGE_PROVIDER=cli
# Opcionales: otro modelo juez y precios (USD por millón de tokens) para que
# --estimar muestre el costo.
# JUDGE_MODEL=claude-sonnet-5-5
# JUDGE_PRICE_INPUT_PER_MTOK=
# JUDGE_PRICE_OUTPUT_PER_MTOK=
